@startuml erd
' Entity relationship diagram, crow's foot (IE) notation. Rules: chapter 16 §9.
' treklink: erd. Drawn by capstone/scripts/srs/render_erd.py, not PlantUML: orthogonal lines on separate
' tracks with a jump at every crossing (§9 rule 3).
' No legend: the document's notation table explains the symbols (§2 rule 9).
!include _treklink-style.puml
hide circle
hide methods
title ERD Rental contracts (excerpt)

entity "organizations" as ORG {
  * id : uuid <<PK>>
  --
  * code : text <<UK>>
  * status : OrganizationStatus
}
entity "rental_contracts" as CON {
  * id : uuid <<PK>>
  --
  * organizationId : uuid <<FK>>
  * status : ContractStatus
}
entity "contract_devices" as CD {
  * id : uuid <<PK>>
  --
  * contractId : uuid <<FK>>
  * deviceId : uuid <<FK>>
  checkedInAt : timestamptz
}
entity "devices" as DEV {
  * id : uuid <<PK>>
  --
  * assetTag : text <<UK>>
}

ORG ||--o{ CON : holds
CON ||--o{ CD : lists
DEV ||--o{ CD : appears in

@enduml
