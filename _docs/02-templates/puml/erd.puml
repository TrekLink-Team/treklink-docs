@startuml erd
' Entity relationship diagram, crow's foot (IE) notation. Rules: chapter 16 §9.
' Square corners and straight ortho lines so each foot is three straight strokes ending on the border.
!include _treklink-style.puml
skinparam linetype ortho
hide circle
hide methods
title ERD Rental contracts (excerpt)

entity "organizations" as ORG {
  * id : uuid <<PK>>
  --
  * code : text <<UK>>
  * status : OrganizationStatus
}
entity "rental_contracts" as CON {
  * id : uuid <<PK>>
  --
  * organizationId : uuid <<FK>>
  * status : ContractStatus
}
entity "contract_devices" as CD {
  * id : uuid <<PK>>
  --
  * contractId : uuid <<FK>>
  * deviceId : uuid <<FK>>
  checkedInAt : timestamptz
}
entity "devices" as DEV {
  * id : uuid <<PK>>
  --
  * assetTag : text <<UK>>
}

ORG ||--o{ CON : holds
CON ||--o{ CD : lists
DEV ||--o{ CD : appears in

legend right
  Crow's foot notation, read at the far end of each line:
  two bars = exactly one;  circle and bar = zero or one
  bar and foot = one or many;  circle and foot = zero or many
  Filled dot = mandatory column
endlegend
@enduml
